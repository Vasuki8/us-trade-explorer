---
import Layout from '../layouts/Layout.astro';
import Explorer from '../components/Explorer.astro';
---

<Layout
  title="Explore sample chapters, flow and period"
  description="Choose a month and trade flow, compare partner values, share a view, and download a source-labelled CSV."
>
  <section class="page-intro">
    <p class="eyebrow">MAKE THE DATA YOUR OWN</p>
    <h1>Follow sample trade across markets.</h1>
    <p class="lede">
      Choose one chapter or all included sample chapters, then a month. Every
      comparison uses the same release and statistical basis. Included chapters
      cover part of trade; their sum is not a country total.
    </p>
  </section>
  <Explorer />
</Layout>
