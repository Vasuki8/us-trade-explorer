---
import Layout from '../layouts/Layout.astro';
import Explorer from '../components/Explorer.astro';
---

<Layout
  title="Explore a product, flow and period"
  description="Choose a month and trade flow, compare partner values, share a view, and download a source-labelled CSV."
>
  <section class="page-intro">
    <p class="eyebrow">MAKE THE DATA YOUR OWN</p>
    <h1>Follow a product across markets.</h1>
    <p class="lede">
      Choose a chapter and month. Every comparison uses the same release and
      statistical basis.
    </p>
  </section>
  <Explorer />
</Layout>
