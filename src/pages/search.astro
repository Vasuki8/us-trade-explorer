---
import Layout from '../layouts/Layout.astro';
import { release, href, productUrl } from '../lib/data';
---

<Layout
  title="Find a product or HS chapter"
  description="Search descriptive product names and HS chapter codes. Choose the classification that matches your product."
  active="Products"
>
  <section class="page-intro">
    <p class="eyebrow">THE PRODUCT DIRECTORY</p>
    <h1>Find the right chapter.</h1>
    <p class="lede">
      Search a product name or a two-digit HS code. Broad terms may match
      several chapters; choose a description before exploring.
    </p>
  </section>
  <form id="product-search" class="search-form" action={href('search/')}>
    <label for="search">Product name or HS code</label>
    <div class="search-row">
      <input
        id="search"
        name="q"
        type="search"
        maxlength="120"
        placeholder="Coffee, electrical, vehicles…"
      />
      <button type="submit">Search</button>
    </div>
  </form>
  <p id="search-summary" role="status">
    Showing all {release.products.length} sample chapters. HS2022 · 2-digit
    classification.
  </p>
  <div class="product-grid" id="product-results">
    {release.products.map((p) => (
      <a
        class="product-card"
        data-product-code={p.code}
        data-product-name={p.name}
        href={productUrl(p.code)}
      >
        <span class="code-pill">HS {p.code}</span>
        <h2>{p.name}</h2>
        <p>Explore US imports, exports and trading partners.</p>
        <span class="card-link">
          View chapter <span aria-hidden="true">↗</span>
        </span>
      </a>
    ))}
  </div>
  <div id="empty-search" class="empty-state" hidden>
    <h2 id="search-guidance-title">No matching sample chapter</h2>
    <p id="search-guidance">
      This preview covers only {release.products.length} sample chapters. Try a
      broader word or a two-digit code. A missing result does not mean that
      trade is zero.
    </p>
    <p id="parent-suggestion" hidden>
      <a id="parent-chapter" href={href('search/')}></a>
    </p>
    <button id="clear-search" class="secondary" type="button">
      Show all sample chapters
    </button>
  </div>
  <aside class="note">
    <strong>A chapter is a starting point.</strong> HS2 groups many products.
    Confirm detailed classifications with official schedules before making
    customs decisions. This site does not provide tariff or customs advice.
  </aside>
  <script>
    import '../scripts/product-search';
  </script>
</Layout>
